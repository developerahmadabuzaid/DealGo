# Copy to .env and adjust. Never commit the real .env.

# Host ports (chosen to avoid clashing with other local stacks)
POSTGRES_PORT=5442
REDIS_PORT=6389
API_PORT=8090
API2_PORT=8091

POSTGRES_PASSWORD=postgres

# Must be at least 32 characters. The API refuses to start in Production without it.
JWT_SECRET=development-only-signing-key-change-me-please-32+

PAYMENT_WEBHOOK_SECRET=development-webhook-secret

# Tawked sends and checks the one-time codes (https://tawked.com). Take the key from the
# application's Keys tab: tk_test_… is the sandbox, which still sends real messages, and
# tk_live_… is production. Production refuses to start without one, because without it nobody can
# sign in and no withdrawal can be confirmed. Leave it empty locally to keep codes on the API,
# where the challenge response echoes them back.
TAWKED_API_KEY=

# Demo accounts use a well-known password; never enable this in Production.
SEED_DEV_DATA=true
ASPNETCORE_ENVIRONMENT=Development
