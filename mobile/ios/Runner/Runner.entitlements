<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (through Firebase). "production" for TestFlight and App Store builds;
	     Xcode switches a debug build on a cable to the development servers by itself. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
