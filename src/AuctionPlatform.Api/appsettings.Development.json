{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5442;Database=auctions;Username=postgres;Password=postgres;Include Error Detail=true"
  },

  "Redis": {
    "Enabled": false
  },

  "Database": {
    "AutoMigrate": true,
    "SeedDevelopmentData": true
  },

  "Payments": {
    "WebhookSecret": "development-webhook-secret"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
