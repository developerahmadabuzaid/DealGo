{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5442;Database=auctions;Username=postgres;Password=postgres;Include Error Detail=true"
  },

  "Jwt": {
    "Issuer": "auction-platform",
    "Audience": "auction-platform-clients",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 0
  },

  "Otp": {
    "CodeLength": 6,
    "ValidForSeconds": 300,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60,
    "MaxRequestsPerHour": 10,
    "AllowSignUpOnLogin": false,
    "ExposeCodeInDevelopment": true
  },

  "Redis": {
    "Enabled": true,
    "ConnectionString": "localhost:6389",
    "InstanceName": "auction:"
  },

  "Auction": {
    "DefaultEntryFee": 20,
    "DefaultRequiredParticipants": 400,
    "DefaultStartDelaySeconds": 7200,
    "DefaultDurationSeconds": 180,
    "DefaultTargetPercentage": 50,
    "DefaultFinalPhasePercentage": 40,
    "DefaultBidIncrement": 20,
    "DefaultExpirationPolicy": "EndAndDistribute",
    "ExtensionSeconds": 60,
    "RefundLosingParticipantsEntryFee": true,
    "RefundWinnerEntryFee": false,
    "RefundDestinationWallet": "Shopping",
    "DefaultCurrency": "USD",
    "PrizeClaimPaymentDays": 7,
    "BidRateLimitPerSecond": 5,
    "BidRateLimitPerMinute": 120,
    "RequireOtpForWithdrawal": true
  },

  "Payments": {
    "Provider": "SANDBOX",
    "WebhookSecret": "",
    "AllowSandboxDeposits": true
  },

  "Firebase": {
    "Enabled": false,
    "ProjectId": "",
    "CredentialsPath": ""
  },

  "Database": {
    "AutoMigrate": true,
    "SeedDevelopmentData": false
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080"
    ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
