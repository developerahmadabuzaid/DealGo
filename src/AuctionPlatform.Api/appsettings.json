{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5442;Database=auctions;Username=postgres;Password=postgres;Include Error Detail=true"
  },

  "Jwt": {
    "Issuer": "auction-platform",
    "Audience": "auction-platform-clients",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 0
  },

  "Otp": {
    "CodeLength": 6,
    "ValidForSeconds": 300,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60,
    "MaxRequestsPerHour": 10,
    "AllowSignUpOnLogin": true,
    "ExposeCodeInDevelopment": true,
    "//TestAccounts": "Phone numbers that sign in with a fixed code and no SMS, for store reviewers and testing. Set only from the environment, never here: Otp__TestAccounts__0500000001=<code>. Sign-in only; withdrawals still need a real code.",
    "TestAccounts": {}
  },

  "Tawked": {
    "//": "Saudi provider that issues, sends and checks one-time codes for mobile numbers. Tawked generates the code itself, so this is not a transport behind our own code. Set the key from the application's Keys tab: tk_test_ for the sandbox, tk_live_ for production. Production refuses to start without it.",
    "ApiKey": "",
    "BaseUrl": "https://tawked.com",
    "Application": "",
    "Autofill": "",
    "TimeoutSeconds": 15
  },

  "Redis": {
    "Enabled": true,
    "ConnectionString": "localhost:6389",
    "InstanceName": "auction:"
  },

  "Auction": {
    "DefaultEntryFee": 20,
    "DefaultRequiredParticipants": 400,
    "DefaultStartDelaySeconds": 7200,
    "DefaultDurationSeconds": 180,
    "DefaultTargetPercentage": 50,
    "DefaultFinalPhasePercentage": 40,
    "DefaultBidIncrement": 20,
    "DefaultExpirationPolicy": "EndAndDistribute",
    "ExtensionSeconds": 60,
    "RefundLosingParticipantsEntryFee": true,
    "RefundWinnerEntryFee": false,
    "RefundDestinationWallet": "Shopping",
    "DefaultCurrency": "SAR",
    "PrizeClaimPaymentHours": 24,
    "BidRateLimitPerSecond": 5,
    "BidRateLimitPerMinute": 120,
    "RequireOtpForWithdrawal": true
  },

  "Payments": {
    "Provider": "SANDBOX",
    "WebhookSecret": "",
    "AllowSandboxDeposits": true
  },
  "Paymob": {
    "//": "Card, mada and Apple Pay top-ups. SecretKey, PublicKey, HmacSecret and IntegrationIds come from the Paymob dashboard and are set only from the environment (Paymob__SecretKey, ...). Without them top-ups are switched off.",
    "BaseUrl": "https://ksa.paymob.com",
    "MinTopUp": 10,
    "MaxTopUp": 20000
  },

  "Firebase": {
    "Enabled": false,
    "ProjectId": "",
    "CredentialsPath": ""
  },

  "Database": {
    "AutoMigrate": true,
    "SeedDevelopmentData": false
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080"
    ]
  },

  "Storage": {
    "//": "Local keeps pictures in wwwroot/uploads. AzureBlob keeps them in a storage account, which is what production needs: a container's disk is thrown away with the container.",
    "Provider": "Local",
    "AccountUrl": "",
    "ConnectionString": "",
    "Container": "uploads",
    "PublicBaseUrl": ""
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
